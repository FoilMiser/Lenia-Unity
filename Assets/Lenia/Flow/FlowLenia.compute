// Assets/Lenia/Flow/FlowLenia.compute
// Flow-Lenia (Unity 6.2 DX11 safe):
// - No loops over runtime values
// - Texture/RWTexture gradient helpers
// - Fixed 1..3 channel guards
// - Alpha forced to 1.0 for UI

#pragma kernel Affinity
#pragma kernel ClearAccum
#pragma kernel AdvectScatter
#pragma kernel Collect

cbuffer Params {
    int   _Width, _Height, _Channels, _KernelSize;    // Kernel size not used in this DX11-safe variant
    float _Dt, _FlowScale, _Temperature;
    float _Mcrit, _Kappa;
    float _FixedScale;
    float _GrowthMu, _GrowthSigma;
    float _ReactionGain;
}

Texture2D<float4>        _State;      // RGB = channels, A ignored
RWTexture2D<float4>      _Affinity;   // write g→RGB, A=1 (also read in AdvectScatter)
RWTexture2D<float4>      _Next;       // next state, A=1
RWStructuredBuffer<uint> _Accum;      // W*H*_Channels (fixed-point)
StructuredBuffer<float>  _Kernel;     // kept for binding parity (unused here)

int2 ClampToDim(int2 v) { return int2(clamp(v.x,0,_Width-1), clamp(v.y,0,_Height-1)); }

#define TG 16

// ---------------- Affinity (3x3 Gaussian blur of MASS + Lenia growth) ----------------
[numthreads(TG, TG, 1)]
void Affinity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    int2 p = int2(id.xy);

    // MASS at 9 taps
    float m00 = dot(_State.Load(int3(ClampToDim(p+int2(-1,-1)),0)).rgb, float3(1,1,1));
    float m10 = dot(_State.Load(int3(ClampToDim(p+int2( 0,-1)),0)).rgb, float3(1,1,1));
    float m20 = dot(_State.Load(int3(ClampToDim(p+int2( 1,-1)),0)).rgb, float3(1,1,1));

    float m01 = dot(_State.Load(int3(ClampToDim(p+int2(-1, 0)),0)).rgb, float3(1,1,1));
    float m11 = dot(_State.Load(int3(ClampToDim(p+int2( 0, 0)),0)).rgb, float3(1,1,1));
    float m21 = dot(_State.Load(int3(ClampToDim(p+int2( 1, 0)),0)).rgb, float3(1,1,1));

    float m02 = dot(_State.Load(int3(ClampToDim(p+int2(-1, 1)),0)).rgb, float3(1,1,1));
    float m12 = dot(_State.Load(int3(ClampToDim(p+int2( 0, 1)),0)).rgb, float3(1,1,1));
    float m22 = dot(_State.Load(int3(ClampToDim(p+int2( 1, 1)),0)).rgb, float3(1,1,1));

    // 3x3 gaussian blur (weights /16)
    float convMass =
        (1*m00 + 2*m10 + 1*m20 +
         2*m01 + 4*m11 + 2*m21 +
         1*m02 + 2*m12 + 1*m22) * (1.0/16.0);

    // Lenia growth on approx-normalized mass
    float denom = (float)max(1, _Channels);
    float u = convMass / denom;
    float sigma = max(_GrowthSigma, 1e-6);
    float t = (u - _GrowthMu) / sigma;
    float g = 2.0 * exp(-0.5 * t * t) - 1.0;

    _Affinity[p] = float4(g, g, g, 1.0);
}

// ---------------- ClearAccum ----------------
[numthreads(TG, TG, 1)]
void ClearAccum (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    uint baseIndex = (uint(id.y) * (uint)_Width + uint(id.x)) * (uint)_Channels;
    if (_Channels > 0) _Accum[baseIndex + 0u] = 0u;
    if (_Channels > 1) _Accum[baseIndex + 1u] = 0u;
    if (_Channels > 2) _Accum[baseIndex + 2u] = 0u;
}

// ---------------- Gradient helpers ----------------
float2 GradChannelTex(Texture2D<float4> tex, int2 p, int chan)
{
    int2 px = ClampToDim(p + int2( 1, 0));
    int2 nx = ClampToDim(p + int2(-1, 0));
    int2 py = ClampToDim(p + int2( 0, 1));
    int2 ny = ClampToDim(p + int2( 0,-1));

    float4 vxp = tex.Load(int3(px,0));
    float4 vxn = tex.Load(int3(nx,0));
    float4 vyp = tex.Load(int3(py,0));
    float4 vyn = tex.Load(int3(ny,0));

    float sx = (chan==0? vxp.x : (chan==1? vxp.y : vxp.z)) - (chan==0? vxn.x : (chan==1? vxn.y : vxn.z));
    float sy = (chan==0? vyp.x : (chan==1? vyp.y : vyp.z)) - (chan==0? vyn.x : (chan==1? vyn.y : vyn.z));
    return 0.5 * float2(sx, sy);
}

float2 GradChannelRW(RWTexture2D<float4> tex, int2 p, int chan)
{
    int2 px = ClampToDim(p + int2( 1, 0));
    int2 nx = ClampToDim(p + int2(-1, 0));
    int2 py = ClampToDim(p + int2( 0, 1));
    int2 ny = ClampToDim(p + int2( 0,-1));

    float4 vxp = tex[px];
    float4 vxn = tex[nx];
    float4 vyp = tex[py];
    float4 vyn = tex[ny];

    float sx = (chan==0? vxp.x : (chan==1? vxp.y : vxp.z)) - (chan==0? vxn.x : (chan==1? vxn.y : vxn.z));
    float sy = (chan==0? vyp.x : (chan==1? vyp.y : vyp.z)) - (chan==0? vyn.x : (chan==1? vyn.y : vyn.z));
    return 0.5 * float2(sx, sy);
}

// mass gradient from _State
float2 GradMass(Texture2D<float4> tex, int2 p)
{
    int2 px = ClampToDim(p + int2( 1, 0));
    int2 nx = ClampToDim(p + int2(-1, 0));
    int2 py = ClampToDim(p + int2( 0, 1));
    int2 ny = ClampToDim(p + int2( 0,-1));

    float3 vxp = tex.Load(int3(px,0)).rgb;
    float3 vxn = tex.Load(int3(nx,0)).rgb;
    float3 vyp = tex.Load(int3(py,0)).rgb;
    float3 vyn = tex.Load(int3(ny,0)).rgb;

    float sx = (vxp.x+vxp.y+vxp.z) - (vxn.x+vxn.y+vxn.z);
    float sy = (vyp.x+vyp.y+vyp.z) - (vyn.x+vyn.y+vyn.z);
    return 0.5 * float2(sx, sy);
}

float WeightAffinity(float mass) { return 1.0 / (1.0 + exp(+_Kappa * (mass - _Mcrit))); }

// ---------------- AdvectScatter ----------------
[numthreads(TG, TG, 1)]
void AdvectScatter (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    int2 p = int2(id.xy);

    float3 conc = _State.Load(int3(p,0)).rgb;
    float  mass = conc.x + conc.y + conc.z;

    float2 gradAff  = GradChannelRW(_Affinity, p, 0); // NOTE: RWTexture variant
    float2 gradMass = GradMass(_State,   p);

    float  w = WeightAffinity(mass);
    float2 F = (w * gradAff - (1.0 - w) * gradMass);
    float2 delta = _Dt * _FlowScale * _Temperature * F;

    float2 tgt = float2(p) + delta;
    float2 ft0 = floor(tgt);
    int2  t0   = int2(ft0);
    float2 f   = saturate(tgt - ft0);

    int2 q00 = ClampToDim(t0);
    int2 q10 = ClampToDim(t0 + int2(1,0));
    int2 q01 = ClampToDim(t0 + int2(0,1));
    int2 q11 = ClampToDim(t0 + int2(1,1));

    float w00 = (1.0 - f.x) * (1.0 - f.y);
    float w10 = (       f.x) * (1.0 - f.y);
    float w01 = (1.0 - f.x) * (       f.y);
    float w11 = (       f.x) * (       f.y);

    uint base00 = (uint(q00.y) * (uint)_Width + uint(q00.x)) * (uint)_Channels;
    uint base10 = (uint(q10.y) * (uint)_Width + uint(q10.x)) * (uint)_Channels;
    uint base01 = (uint(q01.y) * (uint)_Width + uint(q01.x)) * (uint)_Channels;
    uint base11 = (uint(q11.y) * (uint)_Width + uint(q11.x)) * (uint)_Channels;

    if (_Channels > 0) {
        float m = max(0.0, conc.x);
        uint a00 = (uint)round(m * w00 * _FixedScale);
        uint a10 = (uint)round(m * w10 * _FixedScale);
        uint a01 = (uint)round(m * w01 * _FixedScale);
        uint a11 = (uint)round(m * w11 * _FixedScale);
        InterlockedAdd(_Accum[base00 + 0u], a00);
        InterlockedAdd(_Accum[base10 + 0u], a10);
        InterlockedAdd(_Accum[base01 + 0u], a01);
        InterlockedAdd(_Accum[base11 + 0u], a11);
    }
    if (_Channels > 1) {
        float m = max(0.0, conc.y);
        uint a00 = (uint)round(m * w00 * _FixedScale);
        uint a10 = (uint)round(m * w10 * _FixedScale);
        uint a01 = (uint)round(m * w01 * _FixedScale);
        uint a11 = (uint)round(m * w11 * _FixedScale);
        InterlockedAdd(_Accum[base00 + 1u], a00);
        InterlockedAdd(_Accum[base10 + 1u], a10);
        InterlockedAdd(_Accum[base01 + 1u], a01);
        InterlockedAdd(_Accum[base11 + 1u], a11);
    }
    if (_Channels > 2) {
        float m = max(0.0, conc.z);
        uint a00 = (uint)round(m * w00 * _FixedScale);
        uint a10 = (uint)round(m * w10 * _FixedScale);
        uint a01 = (uint)round(m * w01 * _FixedScale);
        uint a11 = (uint)round(m * w11 * _FixedScale);
        InterlockedAdd(_Accum[base00 + 2u], a00);
        InterlockedAdd(_Accum[base10 + 2u], a10);
        InterlockedAdd(_Accum[base01 + 2u], a01);
        InterlockedAdd(_Accum[base11 + 2u], a11);
    }
}

// ---------------- Collect ----------------
[numthreads(TG, TG, 1)]
void Collect (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    int2 p = int2(id.xy);
    uint baseIndex = (uint(p.y) * (uint)_Width + uint(p.x)) * (uint)_Channels;

    float3 outv = 0;

    if (_Channels > 0) { uint r0 = _Accum[baseIndex + 0u]; outv.x = max(0.0, (float)r0 / _FixedScale); _Accum[baseIndex + 0u] = 0u; }
    if (_Channels > 1) { uint r1 = _Accum[baseIndex + 1u]; outv.y = max(0.0, (float)r1 / _FixedScale); _Accum[baseIndex + 1u] = 0u; }
    if (_Channels > 2) { uint r2 = _Accum[baseIndex + 2u]; outv.z = max(0.0, (float)r2 / _FixedScale); _Accum[baseIndex + 2u] = 0u; }

    // Reaction from Affinity (scalar g); integrate and clamp
    float g = _Affinity[p].x;
    outv = saturate(outv + _Dt * _ReactionGain * g);

    _Next[p] = float4(outv, 1.0);
}
