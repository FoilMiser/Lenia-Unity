// FlowLenia.compute — full-res, tiled, precomputed 2D kernel (no sqrt in inner loop)

#pragma kernel ClearAccum
#pragma kernel Affinity
#pragma kernel Gradients
#pragma kernel AdvectScatter
#pragma kernel Collect
#pragma kernel MassSum

#define THREADS_X 16
#define THREADS_Y 16
#define SCALE_FP  65536

cbuffer Params {
    int   _Width;
    int   _Height;
    int   _OffsetX;   // tile offset
    int   _OffsetY;

    // kernel + growth
    int   _KernelSize;  // K = 2*R+1
    float _Mu;
    float _Sigma;
    float _H;

    // flow + integration
    float _Dt;
    float _Alpha;
    float _Beta;
    float _Temperature;
    float _MaxSpeed;

    // modes
    int   _Boundary;
    int   _ScatterMode;

    // param maps toggles
    int   _UseMuMap;
    int   _UseSigmaMap;
    int   _UseTempMap;

    // book-keeping
    int   _SrcChannel;
    int   _DstChannel;

    // reduction
    int   _TilesX;
    int   _TilesY;
}

// Param maps
Texture2D<float> _MuMap;
Texture2D<float> _SigmaMap;
Texture2D<float> _TempMap;

// NEW: 2D kernel texture (K×K), value=0 outside ring support
Texture2D<float> _Kernel2D;

// Per-dispatch
Texture2D<float>         _State;
RWTexture2D<float>       _Affinity;
RWTexture2D<float>       _Next;
RWTexture2D<int>         _Accum;
RWTexture2D<float2>      _GradAff;
RWTexture2D<float2>      _GradConc;

// reduction output
RWStructuredBuffer<int>  _MassTiles;

// ---------- helpers ----------
int reflectCoord(int p, int size) {
    if (size <= 1) return 0;
    int m = (size - 1) * 2;
    int r = p % m; if (r < 0) r += m;
    if (r >= size) r = m - r;
    return r;
}

int2 normCoord(int2 p)
{
    if (_Boundary == 1) {
        int x = (p.x % _Width  + _Width ) % _Width;
        int y = (p.y % _Height + _Height) % _Height;
        return int2(x,y);
    } else if (_Boundary == 2) {
        return int2(reflectCoord(p.x, _Width), reflectCoord(p.y, _Height));
    } else {
        return int2(clamp(p.x,0,_Width-1), clamp(p.y,0,_Height-1));
    }
}

float sampleState (int2 p)        { return _State[normCoord(p)]; }
float sampleMu    (int2 p, float baseMu)    { return (_UseMuMap != 0) ? max(0.0, _MuMap[normCoord(p)]) : baseMu; }
float sampleSigma (int2 p, float baseSigma) { float s = (_UseSigmaMap != 0) ? _SigmaMap[normCoord(p)] : baseSigma; return max(1e-6, s); }
float sampleTemp  (int2 p, float baseT)     { float t = (_UseTempMap != 0) ? _TempMap[normCoord(p)]   : baseT;     return max(0.0, t); }

float bell(float x, float mu, float sigma) { float z=(x-mu)/sigma; return exp(-0.5*z*z); }

// ---------- 0) clear accumulator ----------
[numthreads(THREADS_X, THREADS_Y, 1)]
void ClearAccum(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x >= _Width || p.y >= _Height) return;
    _Accum[p] = 0;
}

// ---------- 1) affinity (conv with precomputed 2D kernel) ----------
[numthreads(THREADS_X, THREADS_Y, 1)]
void Affinity(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x >= _Width || p.y >= _Height) return;

    int K = _KernelSize;
    int R = (K - 1) / 2;

    float acc = 0.0;
    [loop]
    for (int j = 0; j < K; ++j) {
        [loop]
        for (int i = 0; i < K; ++i) {
            float w = _Kernel2D[int2(i,j)];
            if (w == 0.0) continue;
            int2 q = p + int2(i - R, j - R);
            acc += w * sampleState(q);
        }
    }

    float mu = sampleMu(p, _Mu);
    float sg = sampleSigma(p, _Sigma);
    _Affinity[p] = _H * bell(acc, mu, sg);
}

// ---------- 2) gradients ----------
[numthreads(THREADS_X, THREADS_Y, 1)]
void Gradients(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x >= _Width || p.y >= _Height) return;

    int2 pm1m1 = normCoord(p + int2(-1,-1));
    int2 p0m1  = normCoord(p + int2( 0,-1));
    int2 pp1m1 = normCoord(p + int2( 1,-1));
    int2 pm10  = normCoord(p + int2(-1, 0));
    int2 pp10  = normCoord(p + int2( 1, 0));
    int2 pm11  = normCoord(p + int2(-1, 1));
    int2 p01   = normCoord(p + int2( 0, 1));
    int2 pp11  = normCoord(p + int2( 1, 1));

    float gxA = (-1.0)*_Affinity[pm1m1] + (1.0)*_Affinity[pp1m1]
              + (-2.0)*_Affinity[pm10 ] + (2.0)*_Affinity[pp10 ]
              + (-1.0)*_Affinity[pm11 ] + (1.0)*_Affinity[pp11 ];
    float gyA = (-1.0)*_Affinity[pm1m1] + (-2.0)*_Affinity[p0m1] + (-1.0)*_Affinity[pp1m1]
              + ( 1.0)*_Affinity[pm11 ] + ( 2.0)*_Affinity[p01 ] + ( 1.0)*_Affinity[pp11 ];
    gxA *= (1.0/8.0); gyA *= (1.0/8.0);

    float gxC = (-1.0)*_State[pm1m1] + (1.0)*_State[pp1m1]
              + (-2.0)*_State[pm10 ] + (2.0)*_State[pp10 ]
              + (-1.0)*_State[pm11 ] + (1.0)*_State[pp11 ];
    float gyC = (-1.0)*_State[pm1m1] + (-2.0)*_State[p0m1] + (-1.0)*_State[pp1m1]
              + ( 1.0)*_State[pm11 ] + ( 2.0)*_State[p01 ]  + ( 1.0)*_State[pp11 ];
    gxC *= (1.0/8.0); gyC *= (1.0/8.0);

    _GradAff[p]  = float2(gxA, gyA);
    _GradConc[p] = float2(gxC, gyC);
}

// ---------- 3) advect + scatter ----------
[numthreads(THREADS_X, THREADS_Y, 1)]
void AdvectScatter(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x >= _Width || p.y >= _Height) return;

    float2 gA = _GradAff[p];
    float2 gC = _GradConc[p];
    float2 v  = _Alpha * gA + _Beta * (-gC);

    if (_MaxSpeed > 0.0) {
        float L = length(v);
        if (L > _MaxSpeed) v *= (_MaxSpeed / L);
    }

    float m = max(0.0, _State[p]);
    float2 dest = (float2)p + v * _Dt;

    float T = (_UseTempMap != 0) ? max(0.0, _TempMap[normCoord(p)]) : _Temperature;
    int mode = (_ScatterMode == 0) ? ((T < 0.5) ? 1 : 2) : _ScatterMode;

    if (mode == 1) {
        float2 d  = dest;
        int2   q0 = int2(floor(d));
        float2 f  = frac(d);
        float  w00 = (1.0 - f.x)*(1.0 - f.y);
        float  w10 = (      f.x)*(1.0 - f.y);
        float  w01 = (1.0 - f.x)*(      f.y);
        float  w11 = (      f.x)*(      f.y);

        int M = (int)round(m * SCALE_FP);
        int s00 = (int)round(w00 * M);
        int s10 = (int)round(w10 * M);
        int s01 = (int)round(w01 * M);
        int s11 = M - (s00 + s10 + s01);

        int2 q;
        q = normCoord(q0 + int2(0,0)); InterlockedAdd(_Accum[q], s00);
        q = normCoord(q0 + int2(1,0)); InterlockedAdd(_Accum[q], s10);
        q = normCoord(q0 + int2(0,1)); InterlockedAdd(_Accum[q], s01);
        q = normCoord(q0 + int2(1,1)); InterlockedAdd(_Accum[q], s11);
    } else {
        int Tmin = (int)floor(-T);
        int Tmax = (int)ceil(T);
        int cells = (Tmax - Tmin + 1) * (Tmax - Tmin + 1);
        if (cells < 1) cells = 1;

        int share = (int)round((m * SCALE_FP) / cells);

        [loop]
        for (int dy = Tmin; dy <= Tmax; ++dy)
            [loop]
            for (int dx = Tmin; dx <= Tmax; ++dx) {
                int2 q = int2((int)round(dest.x) + dx, (int)round(dest.y) + dy);
                q = normCoord(q);
                InterlockedAdd(_Accum[q], share);
            }
    }
}

// ---------- 4) collect ----------
[numthreads(THREADS_X, THREADS_Y, 1)]
void Collect(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x >= _Width || p.y >= _Height) return;

    int v = _Accum[p];
    float m = (float)v / (float)SCALE_FP;
    _Next[p] = max(0.0, m);
    _Accum[p] = 0;
}

// ---------- mass sum ----------
groupshared int gTileSum;
[numthreads(THREADS_X, THREADS_Y, 1)]
void MassSum(uint3  id  : SV_DispatchThreadID,
             uint3 gid : SV_GroupID,
             uint3 tid : SV_GroupThreadID)
{
    if (tid.x == 0 && tid.y == 0) gTileSum = 0;
    GroupMemoryBarrierWithGroupSync();

    int2 p = int2(id.xy) + int2(_OffsetX, _OffsetY);
    if (p.x < _Width && p.y < _Height) {
        int fp = (int)round( max(0.0, _State[p]) * SCALE_FP );
        InterlockedAdd(gTileSum, fp);
    }

    GroupMemoryBarrierWithGroupSync();
    if (tid.x == 0 && tid.y == 0) {
        int tileIndex = gid.x + gid.y * _TilesX;
        _MassTiles[tileIndex] = gTileSum;
    }
}
